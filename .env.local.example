# Sentry Configuration
# Get your DSN from: https://sentry.io/settings/projects/

# Client-side DSN (public, exposed to the browser)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Server-side DSN (can be the same as NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=your_sentry_dsn_here

# Sentry organization slug (for source map uploads)
SENTRY_ORG=your_org_slug

# Sentry project slug
SENTRY_PROJECT=your_project_slug

# Sentry auth token (for uploading source maps)
# Get this from: https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
SENTRY_AUTH_TOKEN=your_auth_token_here
